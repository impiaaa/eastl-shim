    inline float stof ( const eastl::string& str, ::size_t* pos = nullptr ) {
        char* ptr;
        float ret = ::strtof(str.c_str(), &ptr);
        if (pos != nullptr) {
            *pos = ptr-str.c_str();
        }
        return ret;
    }
    inline float stof ( const eastl::wstring& str, ::size_t* pos = nullptr ) {
        wchar_t* ptr;
        float ret = ::wcstof(str.c_str(), &ptr);
        if (pos != nullptr) {
            *pos = ptr-str.c_str();
        }
        return ret;
    }
